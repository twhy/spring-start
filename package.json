{
  "name": "spring-start",
  "version": "0.1.0",
  "description": "Generate Spring Boot projects from start.spring.io",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "sprint": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --clean --out-dir dist --sourcemap",
    "postbuild": "chmod +x dist/index.js",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.5.0",
    "typescript": "^7"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "picocolors": "^1.1.1",
    "adm-zip": "^0.6.1",
    "cac": "^7.1.0"
  }
}
